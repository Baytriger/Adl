# Postgres connection string (Supabase: Connect -> Direct -> Session pooler). Keep it secret.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adl"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Comma-separated emails allowed to create the first admin account on the setup screen.
ADL_ADMIN_EMAILS=""
# Production: set to your public https URL (or AUTH_TRUST_HOST=true behind a trusted proxy)
AUTH_URL=""
AUTH_TRUST_HOST=""
ADL_SESSION_HOURS="8"
